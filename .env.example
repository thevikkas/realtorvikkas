# Realtor Vikkas Platform — Environment Configuration

# Application
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=10000

# Database
DB_PATH=./realtor_vikkas.db
DB_BACKUP_PATH=./backups

# Security
SESSION_TIMEOUT=86400
PASSWORD_RESET_TOKEN_EXPIRY=3600
CSRF_TOKEN_EXPIRY=3600

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SUPPORT_EMAIL=support@realtorvikkas.com

# Integrations (optional)
GOOGLE_MAPS_API_KEY=
STRIPE_API_KEY=
TWILIO_ACCOUNT_SID=

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Performance
DB_POOL_SIZE=10
CACHE_TTL=3600
API_RATE_LIMIT=1000

# Features (enable/disable)
FEATURE_INVESTMENT_CALCULATOR=true
FEATURE_DEAL_ROOM=true
FEATURE_CONCIERGE=true
FEATURE_CRM=true
FEATURE_API=true

# Analytics
ANALYTICS_ENABLED=false
ANALYTICS_API_KEY=

# Backup
AUTO_BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
